# Local play works with every value empty.
# Sign-in is optional. Both Clerk keys turn on "sign up or log in" before you play.
# Saved progress for an account, and invite sessions, need Supabase.
# Do not run `npx clerk init`. Copy this file to .env.local and fill the values there.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. The API writes profiles and sessions with this key.
# Run supabase/schema.sql first, and add Clerk as a Supabase third-party auth provider.
SUPABASE_SERVICE_ROLE_KEY=
